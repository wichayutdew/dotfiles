{
  "mcpServers": {
    "context7": {
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "${CONTEXT7_API_KEY}"
      },
      "directTools": [
        "resolve-library-id",
        "query-docs"
      ]
    },
    "atlassian": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-remote@latest",
        "https://mcp.atlassian.com/v1/mcp/authv2"
      ],
      "directTools": true
    },
    "gitlab": {
      "url": "${GITLAB_MCP}",
      "auth": "oauth",
      "directTools": true
    },
    "figma": {
      "url": "https://mcp.figma.com/mcp",
      "auth": "oauth",
      "oauth": {
        "clientId": "${FIGMA_CLIENT_ID}",
        "clientSecret": "${FIGMA_CLIENT_SECRET}"
      },
      "directTools": false
    },
    "agoda_skills": {
      "url": "${AGODA_SKILLS_MCP}",
      "headers": {
        "X-Agoda-Skills-Version": "20260224.0.0"
      },
      "directTools": true
    },
    "glean": {
      "url": "${GLEAN_MCP}",
      "auth": "oauth",
      "directTools": [
        "code_search",
        "read_document",
        "search"
      ]
    },
    "sourcegraph": {
      "url": "${SOURCEGRAPH_MCP}",
      "headers": {
        "Authorization": "token ${SOURCEGRAPH_TOKEN}"
      },
      "directTools": [
        "code_finder",
        "commit_search",
        "diff_search",
        "evaluator",
        "keyword_search",
        "list_files",
        "list_repos",
        "nls_search",
        "read_file"
      ]
    },
    "grafana": {
      "url": "${GRAFANA_MCP}",
      "auth": false,
      "directTools": true,
      "headers": {
        "X-Grafana-Org-Id": "1"
      }
    },
    "slack": {
      "url": "${SLACK_MCP}",
      "directTools": true
    },
    "gh_grep": {
      "url": "https://mcp.grep.app",
      "auth": false,
      "directTools": [
        "searchGitHub"
      ]
    },
    "superset": {
      "url": "${SUPERSET_MCP}",
      "directTools": true
    },
    "query-writer": {
      "url": "${QUERY_WRITER_MCP}",
      "headers": {},
      "directTools": true
    },
    "opsbot": {
      "url": "${OPSBOT_MCP}",
      "headers": {},
      "directTools": true
    }
  }
}
